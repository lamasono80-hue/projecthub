# ==========================================
# ProjectHub - Environment Variables Template
# ==========================================
# Sao chép file này thành .env và điền giá trị thật
# KHÔNG commit file .env vào Git
# ==========================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Supabase ---
# Lấy từ: https://app.supabase.com > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- OpenAI ---
# Lấy từ: https://platform.openai.com/api-keys
# Chỉ backend mới được dùng key này — KHÔNG để vào frontend
OPENAI_API_KEY=sk-...your-openai-key

# --- Cloudinary ---
# Lấy từ: https://console.cloudinary.com > Dashboard
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# --- GitHub API (optional, tăng rate limit) ---
# Lấy từ: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_...your-github-token
